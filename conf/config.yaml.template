version: "1.3.1"
tar_gene: GENE
gse_id: GSE123456
data_dir: data
group_select_col: source_name_ch1
control_label: ['control']
exp_label: ['CCl4']
exp_type: "Fibrosis"
analysis_mode: "diff" 
storage: true
strict_mode: false
debug: false
p_threshold: 0.05
log_threshold: 10
strict_filter: true
signs:
- positive
- negative

# Enrichment analysis (for analysis_mode: "enrich")
enrichment_source_mode: "diff"
enrichment_gene_sets:
  - KEGG_2026
  - GO_Biological_Process_2025
  - GO_Molecular_Function_2025
  - GO_Cellular_Component_2025
organism: "human"
log2fc_threshold: 0.5
max_input_genes: 500
max_output_genes: 0
gene_blacklist: []
group_memory_enabled: false
group_memory_use: false
tar_tuple: ""
process: "123"

# 多基因模式（与 tar_gene 互斥，二选一）
# 支持逗号分隔: multi_gene: "APEX1,TP53,TGFB1"
# 支持文件输入: multi_gene: "/path/to/gene_list.txt"（每行一个基因，# 开头为注释）
# multi_gene: ""

# 图片覆盖模式：true=直接覆盖，false=迭代编号 (1)(2)...
overwrite_figures: false

# 免疫浸润去卷积方法: cibersort / DeconRNASeq / ssGSEA / SingScore
immune_method: "DeconRNASeq"

# hydra配置
hydra:
  job_logging:
    handlers:
      console:
        level: INFO